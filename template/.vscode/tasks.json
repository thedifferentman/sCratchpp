{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Scratch: Build .sb3",
            "type": "process",
            "command": "scrate",
            "args": ["build"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Scratch: Debug",
            "type": "process",
            "command": "scrate",
            "args": ["build", "--debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        }
    ]
}
